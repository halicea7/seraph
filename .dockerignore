# Keep the build context small & secret-free.

# Python / venv
.venv/
venv/
env/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# frontend/ IS needed in the build context — frontend/Dockerfile.frontend
# builds it (see docker-compose.prod.yml / docker-compose.demo.yml), and it
# shares one npm workspace with electron/ rooted here. Dockerfile.backend
# doesn't COPY frontend/ regardless, so excluding it here would only break
# the frontend image for no benefit to the backend one.
**/node_modules/
**/dist/
electron/out/
*.tsbuildinfo

# VCS & IDE
.git/
.gitignore
.vscode/
.idea/

# Secrets & local state (provided at runtime via env_file, never baked in)
.env
.env.*
!.env.example
certs/
*.pem
*.key
*.crt

# Databases & scan artifacts
*.db
*.sqlite
*.sqlite3
seraph_results/
*.log
logs/

# Repo docs not needed in the image
INTERVIEW_PREP.md
PLAN.md
README.md
docs/
