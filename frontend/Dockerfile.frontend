# Build context must be the repo root, not frontend/ — see
# docker-compose.prod.yml / docker-compose.demo.yml. The renderer source
# here is shared with electron/ via one npm workspace rooted one level up,
# so the lockfile lives there too, not in this directory.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
COPY electron/package.json ./electron/package.json
RUN npm ci
COPY frontend/ ./frontend
RUN npm run build --workspace=frontend

FROM nginx:alpine
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
